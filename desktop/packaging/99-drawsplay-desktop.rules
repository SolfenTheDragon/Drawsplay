# Lets the user who is logged in at the console create virtual keyboards, touchscreens and pens through
# /dev/uinput, which dd-host uses to inject input on Linux. "uaccess" grants access to the active local
# session only, through an ACL that systemd-logind adds and removes; nobody needs to join a group.
#
# Do not put users in the "input" group for this: that group can also read every keyboard and mouse on the
# machine (keystrokes included). Only if dd-host must run without a local login session (over ssh, as a
# system service) give /dev/uinput to a group of your own instead, for example:
#   KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="drawsplay-uinput", MODE="0660", OPTIONS+="static_node=uinput"
#
# Install: sudo cp 99-drawsplay-desktop.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
