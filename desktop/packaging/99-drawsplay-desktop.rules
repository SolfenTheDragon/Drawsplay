# Lets members of the "input" group create virtual keyboards, touchscreens and pens through
# /dev/uinput, which dd-host uses to inject input on Linux.
# Install: sudo cp 99-drawsplay-desktop.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Then add yourself to the group (log out and in afterwards): sudo usermod -aG input "$USER"
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
