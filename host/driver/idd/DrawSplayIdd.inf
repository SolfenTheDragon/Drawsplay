;
; DrawSplayIdd.inf - DrawSplay IddCx virtual display driver.
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=DrawSplayIdd.cat
DriverVer = 10/16/2026,1.0.2.0

[Manufacturer]
; IddCx 1.4 (the version the driver is built against) ships with Windows 10
; 1903 (build 18362), so older-GPU machines still on Windows 10 get the
; virtual display too.
%ManufacturerName%=Standard,NTamd64.10.0...18362

[Standard.NTamd64.10.0...18362]
%DeviceName%=DrawSplayIdd_Install, Root\DrawSplayIdd

[SourceDisksFiles]
DrawSplayIdd.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[DrawSplayIdd_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[DrawSplayIdd_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = DrawSplayIdd_HardwareDeviceSettings

[DrawSplayIdd_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "DrawSplayIddGroup"
HKR,, "Security", %REG_SZ%, "D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;AU)"

[DrawSplayIdd_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[DrawSplayIdd_Install.NT.Wdf]
UmdfService=DrawSplayIdd,DrawSplayIdd_Install
UmdfServiceOrder=DrawSplayIdd
UmdfKernelModeClientPolicy = AllowKernelModeClients

[DrawSplayIdd_Install]
UmdfLibraryVersion=2.25.0
ServiceBinary=%12%\UMDF\DrawSplayIdd.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
DrawSplayIdd.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="DrawSplay"
DiskName = "DrawSplay Virtual Display Installation Disk"
DeviceName="DrawSplay Virtual Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
