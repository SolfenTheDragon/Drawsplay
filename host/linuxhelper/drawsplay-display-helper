#!/bin/bash
# DrawSplay display helper: the only commands the DrawSplay host runs as root on Linux.
# Installed root-owned at /usr/libexec/drawsplay/drawsplay-display-helper and run through
# pkexec, so the password prompt names this action (com.drawsplay.display-helper) instead of
# "run a shell as root". Every argument is checked; anything else is refused.
#
#   drawsplay-display-helper connector /sys/class/drm/cardN-HDMI-A-M/status on|detect
#   drawsplay-display-helper vkms-load
#   drawsplay-display-helper vkms-release
#   drawsplay-display-helper vkms-unload
#   drawsplay-display-helper udev-rule uinput|aoa
#   drawsplay-display-helper packages ffmpeg|wayland-capture
#   drawsplay-display-helper edid-install drawsplay-WxH.bin HEX
#   drawsplay-display-helper edid-firmware HDMI-A-N drawsplay-WxH.bin|-
#
# The Web UI's setup checklist runs the last three when the user clicks a fix
# button. The host carries a copy of this file (host/linuxhelper) and runs that
# copy through pkexec when the installed helper is older and lacks an action;
# a host test keeps the two identical.
#
# vkms is never shown to the X server untested. vkms-load installs
# 72-drawsplay-vkms-hold.rules first, so the new device is held from X (it
# gets a seat name X ignores), and hands the held device to the calling user.
# The host then checks it (host/vkms_probe_linux.go) and runs vkms-release
# only when the kernel could show the GPU's frames on it; otherwise it runs
# vkms-unload, and X never saw the device. vkms-unload also takes a device X
# already uses away from X first (a fresh "add" event with the hold back in
# place makes X remove it), so the module can be unloaded without logging out.
#
# A connector call also installs the udev rule 70-drawsplay-drm-connector.rules
# when it is missing and opens the HDMI status files to the plugdev group right
# away, so the password is asked once: every later boot the host writes the
# connector itself.
#
# edid-install writes a tablet EDID the host generated (host/edid.go) to
# /lib/firmware/edid, after checking that it is one (header, DrawSplay's
# manufacturer and product code, one or two blocks), and installs
# 71-drawsplay-edid-override.rules so the host sets drm.edid_firmware itself
# from then on. edid-firmware sets or removes the host's entry in
# drm.edid_firmware for one HDMI port, for when that rule is not in effect
# (the user is not in the plugdev group); it keeps every entry the host did not
# add.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

DRM_RULE_TARGET=/etc/udev/rules.d/70-drawsplay-drm-connector.rules
# Kept identical to packaging/linux/70-drawsplay-drm-connector.rules (a host
# test checks this).
DRM_RULE='ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]*-HDMI-A-[0-9]*", RUN+="/bin/sh -c '"'"'chgrp plugdev /sys%p/status && chmod 0664 /sys%p/status'"'"'"'

# open_connectors_to_plugdev makes the spare-connector fallback work without
# root from now on. Failures here are not failures of the connector switch.
open_connectors_to_plugdev() {
  getent group plugdev >/dev/null 2>&1 || return 0
  local f
  for f in /sys/class/drm/card[0-9]*-HDMI-A-[0-9]*/status; do
    [[ -e "$f" ]] || continue
    chgrp plugdev "$f" 2>/dev/null && chmod 0664 "$f" 2>/dev/null || true
  done
  if [[ ! -e "$DRM_RULE_TARGET" ]] && [[ -d /etc/udev/rules.d ]]; then
    {
      echo "# DrawSplay: lets members of the plugdev group force a spare, unplugged HDMI"
      echo "# connector on or off without root (written by drawsplay-display-helper;"
      echo "# same as packaging/linux/70-drawsplay-drm-connector.rules)."
      echo "$DRM_RULE"
    } >"$DRM_RULE_TARGET".tmp && mv "$DRM_RULE_TARGET".tmp "$DRM_RULE_TARGET" || { rm -f "$DRM_RULE_TARGET".tmp; return 0; }
    chmod 0644 "$DRM_RULE_TARGET" || true
    command -v udevadm >/dev/null 2>&1 && udevadm control --reload-rules 2>/dev/null || true
  fi
}

EDID_RULE_TARGET=/etc/udev/rules.d/71-drawsplay-edid-override.rules
EDID_PARAM=/sys/module/drm/parameters/edid_firmware
EDID_DIR=/lib/firmware/edid
EDID_NAME_RE='^drawsplay-[0-9]{3,4}x[0-9]{3,4}\.bin$'

# open_edid_override_to_plugdev installs 71-drawsplay-edid-override.rules and
# applies it now, so the host sets its drm.edid_firmware entry without root.
open_edid_override_to_plugdev() {
  edid_override_rule | install_rule "$EDID_RULE_TARGET"
  getent group plugdev >/dev/null 2>&1 || return 0
  [[ -e "$EDID_PARAM" ]] || return 0
  chgrp plugdev "$EDID_PARAM" 2>/dev/null && chmod 0664 "$EDID_PARAM" 2>/dev/null || true
}

# set_edid_override CONNECTOR NAME|-: puts CONNECTOR:edid/NAME first in
# drm.edid_firmware (or, with -, leaves it out), dropping every other DrawSplay
# entry and keeping all others.
set_edid_override() {
  [[ -e "$EDID_PARAM" ]] || { echo "this kernel has no drm.edid_firmware parameter" >&2; exit 8; }
  local cur e out=()
  cur=$(tr -d '\000\n' <"$EDID_PARAM")
  [[ "$2" != - ]] && out+=("$1:edid/$2")
  local IFS=, e_list
  read -ra e_list <<<"$cur"
  for e in "${e_list[@]}"; do
    [[ -z "$e" || "$e" == *:edid/drawsplay-* ]] && continue
    out+=("$e")
  done
  if ((${#out[@]})); then
    printf '%s' "${out[*]}" >"$EDID_PARAM"
  else
    # A lone NUL empties the parameter; a newline would count as a file name.
    printf '\0' >"$EDID_PARAM"
  fi
}

# The udev rules below are the files in packaging/linux, verbatim (a host test
# checks this).
vkms_hold_rule() {
  cat <<'RULE'
# DrawSplay: keep the X server, Wayland compositors and the desktop away from the vkms
# virtual display until DrawSplay has checked, in this boot, that the kernel can show the
# real GPU's frames on it (host/vkms_probe_linux.go).
#
# On some kernel and GPU pairs (Intel's xe driver, for one) vkms cannot map the GPU's
# buffers. Once X adds the device, the desktop enables its output at once, the mode set
# fails in vkms_prepare_fb, and that has frozen the display. Until
# /run/drawsplay/vkms-verified exists, a vkms device gets a seat name that X and the
# compositors skip; it is not a valid logind seat either, so no login screen starts on it.
# /run is emptied at every boot, so each boot starts held again.
#
# Installed by the DrawSplay installer and the display helper; remove it to use vkms
# without DrawSplay's check.
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", KERNELS=="vkms", TEST!="/run/drawsplay/vkms-verified", ENV{ID_SEAT}="drawsplay-hold"
RULE
}

VKMS_HOLD_TARGET=/etc/udev/rules.d/72-drawsplay-vkms-hold.rules
VKMS_VERIFIED=/run/drawsplay/vkms-verified

# vkms_card prints the sysfs directory of the vkms DRM card, if any.
vkms_card() {
  local d
  for d in /sys/class/drm/card[0-9]*; do
    [[ "${d##*/}" =~ ^card[0-9]+$ ]] || continue
    [[ "$(basename "$(readlink -f "$d/device")")" == vkms ]] || continue
    echo "$d"
    return 0
  done
  return 1
}

# vkms_held CARD_SYSFS_DIR: is the card currently hidden from X?
vkms_held() {
  udevadm info -q property -p "$1" 2>/dev/null | grep -qx 'ID_SEAT=drawsplay-hold'
}

# vkms_readd CARD_SYSFS_DIR: replays the card's "add" event. X removes and
# re-adds a DRM device on "add"; the hold rule decides whether it comes back.
vkms_readd() {
  udevadm trigger --action=add --settle "$1" 2>/dev/null ||
    { udevadm trigger --action=add "$1" && udevadm settle -t 10; }
}

# caller_uid: the user pkexec or sudo ran us for (empty when run by root).
caller_uid() {
  local uid="${PKEXEC_UID:-${SUDO_UID:-}}"
  [[ "$uid" =~ ^[0-9]+$ ]] && [[ "$uid" != 0 ]] && echo "$uid"
  return 0
}

uinput_rule() {
  cat <<'RULE'
# Lets the user logged in at this computer create virtual pens, touchscreens and keyboards through
# /dev/uinput. Both the DrawSplay host (Android tablets) and DrawSplay Desktop's dd-host inject input
# this way, and both installers install this same file.
#
# "uaccess" grants access to the active local session only, through an ACL that systemd-logind adds
# and removes; nobody needs to join a group. Do not put users in the "input" group for this: that
# group can also read every keyboard and mouse on the machine (keystrokes included). Only if the host
# must run without a local login session (over ssh, as a system service) give /dev/uinput to a group
# of your own instead, for example:
#   KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="drawsplay-uinput", MODE="0660", OPTIONS+="static_node=uinput"
#
# Install: sudo install -m 0644 99-drawsplay-uinput.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger --name-match=uinput
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
RULE
}

