<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/ds_disabled" />
            <stroke android:width="1dp" android:color="@color/ds_border" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/ds_bg" />
            <stroke android:width="2dp" android:color="@color/ds_accent" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ds_bg" />
            <stroke android:width="1dp" android:color="@color/ds_muted" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</selector>
