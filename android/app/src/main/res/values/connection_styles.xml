<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DrawSplay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/ds_accent</item>
        <item name="android:statusBarColor">@color/ds_bg</item>
        <item name="android:navigationBarColor">@color/ds_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
    <style name="DrawSplay.PrimaryButton" parent="DrawSplay.SecondaryButton">
        <item name="android:background">@drawable/ds_button</item>
        <item name="android:textColor">@color/ds_primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DrawSplay.SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/ds_button_secondary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
