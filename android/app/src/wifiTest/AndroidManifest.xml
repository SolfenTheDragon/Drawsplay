<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="DrawSplay isolated Wi-Fi tests" tools:replace="android:label">
        <!-- Product activity without the USB-accessory filter, so the isolated package never claims USB. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            tools:node="replace" />
        <activity android:name=".AccessoryIgnoreActivity" tools:node="remove" />
        <activity android:name=".WiFiEnrollmentProbeActivity" android:exported="true" />
        <activity android:name=".WiFiSelfTestActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
