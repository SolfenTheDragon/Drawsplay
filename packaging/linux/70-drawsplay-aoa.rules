# DrawSplay: let the logged-in user talk to Android tablets over USB without adb or Developer options.
# Install: sudo cp 70-drawsplay-aoa.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# then replug the tablet. "uaccess" grants access to the active local session only (no group membership needed).

# Accessory-mode device (what DrawSplay streams over).
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", TAG+="uaccess", ATTR{power/control}="on"

# Tablets in their normal mode: needed once so DrawSplay can ask them to switch to accessory mode.
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", TAG+="uaccess"  # Google
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", TAG+="uaccess"  # Samsung
SUBSYSTEM=="usb", ATTR{idVendor}=="12d1", TAG+="uaccess"  # Huawei
SUBSYSTEM=="usb", ATTR{idVendor}=="2717", TAG+="uaccess"  # Xiaomi
SUBSYSTEM=="usb", ATTR{idVendor}=="17ef", TAG+="uaccess"  # Lenovo
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", TAG+="uaccess"  # ASUS
SUBSYSTEM=="usb", ATTR{idVendor}=="1004", TAG+="uaccess"  # LG
SUBSYSTEM=="usb", ATTR{idVendor}=="054c", TAG+="uaccess"  # Sony
SUBSYSTEM=="usb", ATTR{idVendor}=="0bb4", TAG+="uaccess"  # HTC
SUBSYSTEM=="usb", ATTR{idVendor}=="22b8", TAG+="uaccess"  # Motorola
SUBSYSTEM=="usb", ATTR{idVendor}=="2a70", TAG+="uaccess"  # OnePlus
SUBSYSTEM=="usb", ATTR{idVendor}=="22d9", TAG+="uaccess"  # OPPO
SUBSYSTEM=="usb", ATTR{idVendor}=="1949", TAG+="uaccess"  # Amazon
SUBSYSTEM=="usb", ATTR{idVendor}=="0502", TAG+="uaccess"  # Acer
