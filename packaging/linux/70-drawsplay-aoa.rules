# DrawSplay: let the logged-in user talk to Android tablets over USB without adb or Developer options.
# Install: sudo cp 70-drawsplay-aoa.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# then replug the tablet. "uaccess" grants access to the active local session only (no group membership needed).

# Accessory-mode device (what DrawSplay streams over).
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0-5]", TAG+="uaccess", ATTR{power/control}="on"

# Tablets in their normal mode: needed once so DrawSplay can ask them to switch to accessory mode.
# Matching the vendor alone would also open up that vendor's keyboards, mice, docks, storage,
# Bluetooth/Wi-Fi adapters and printers to raw access by any program of the logged-in user, so
# devices with HID (03), printer (07), mass-storage (08), hub (09) or wireless-controller (e0)
# interfaces are skipped. Android tablets expose only MTP/PTP (06), ADB (ff/42) or vendor (ff)
# interfaces, or none in "No data transfer" mode. (A tablet in USB tethering mode is skipped too.)
# Google
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}!="*:03????:*|*:07????:*|*:08????:*|*:09????:*|*:e0????:*", ATTR{idVendor}=="18d1", TAG+="uaccess"
# Samsung
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}!="*:03????:*|*:07????:*|*:08????:*|*:09????:*|*:e0????:*", ATTR{idVendor}=="04e8", TAG+="uaccess"
