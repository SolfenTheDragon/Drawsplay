<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DrawSplay</vendor>
  <action id="com.drawsplay.display-helper">
    <description>Prepare a virtual display for the DrawSplay tablet</description>
    <message>DrawSplay needs to switch on a spare display port, or load the virtual display module, to extend your desktop onto the tablet</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/drawsplay/drawsplay-display-helper</annotate>
  </action>
</policyconfig>
